# AlMuden environment configuration
# Copy to .env and adjust. All values have sensible defaults in config.py.

# ── Mode ──────────────────────────────────────────────────────────────
# paper (default) | live
# ALMUDEN_MODE=paper

# ── Exchange API keys (only needed for live mode) ─────────────────────
# KUCOIN_API_KEY=
# KUCOIN_SECRET=
# KUCOIN_PASSPHRASE=
# GATEIO_API_KEY=
# GATEIO_SECRET=
# MEXC_API_KEY=
# MEXC_SECRET=
# KRAKEN_API_KEY=
# KRAKEN_SECRET=
# WHITEBIT_API_KEY=
# WHITEBIT_SECRET=

# ── Venues & symbols ──────────────────────────────────────────────────
# Comma-separated venue IDs (default: kucoin,gateio,mexc,kraken,whitebit)
# ALMUDEN_VENUES=kucoin,gateio,mexc,kraken,whitebit

# ── Arbitrage parameters ──────────────────────────────────────────────
# Minimum net edge in basis points to trigger a trade (default: 10)
# ALMUDEN_MIN_EDGE_BPS=10
# Maximum position size in quote currency per cycle (default: 100)
# ALMUDEN_MAX_POSITION=100
# Maximum inventory drift before rebalance, in bps (default: 500 = 5%)
# ALMUDEN_MAX_DRIFT_BPS=500

# ── Triangular arbitrage ─────────────────────────────────────────────
# Enable triangular arb scanning (default: true)
# ALMUDEN_TRIANGULAR_ENABLED=true
# Cross-pair symbols to poll for triangular cycles (default: XMR/ERG,ERG/XMR)
# ALMUDEN_TRIANGULAR_SYMBOLS=XMR/ERG,ERG/XMR

# ── Environment / market intelligence ───────────────────────────────
# Seconds between news polls (default: 60)
# ALMUDEN_NEWS_POLL_INTERVAL=60
# Number of observations for regime detection (default: 20)
# ALMUDEN_REGIME_LOOKBACK=20
# Minimum absolute sentiment score to report (default: 0.3)
# ALMUDEN_SENTIMENT_THRESHOLD=0.3

# ── Strategy lab / backtesting ─────────────────────────────────────
# Directory for cached OHLCV data (default: .cache)
# ALMUDEN_BACKTEST_CACHE_DIR=.cache
# Number of Monte Carlo simulation draws (default: 1000)
# ALMUDEN_MONTE_CARLO_DRAWS=1000

# ── Agent system ──────────────────────────────────────────────────
# Ollama server URL (default: http://localhost:11434)
# ALMUDEN_OLLAMA_URL=http://localhost:11434
# Ollama model name (default: llama3)
# ALMUDEN_OLLAMA_MODEL=llama3
# Directory for persistent memory (default: .memory)
# ALMUDEN_MEMORY_DIR=.memory
# Short-term memory capacity (default: 50)
# ALMUDEN_SHORT_TERM_CAPACITY=50

# ── API server ────────────────────────────────────────────────────
# API server host (default: 0.0.0.0)
# ALMUDEN_API_HOST=0.0.0.0
# API server port (default: 8080)
# ALMUDEN_API_PORT=8080
# API key (auto-generated if empty)
# ALMUDEN_API_KEY=

# ── Risk engine (live trading) ─────────────────────────────────────
# Max drawdown percentage before stopping (default: 10)
# ALMUDEN_MAX_DRAWDOWN_PCT=10
# Max daily loss in quote currency (default: 100)
# ALMUDEN_MAX_DAILY_LOSS=100
# Max concurrent open orders (default: 5)
# ALMUDEN_MAX_OPEN_ORDERS=5
# Max consecutive losses before circuit breaker (default: 5)
# ALMUDEN_MAX_CONSECUTIVE_LOSSES=5
# Max exposure per venue (default: 500)
# ALMUDEN_MAX_VENUE_EXPOSURE=500
# Max API errors per minute (default: 10)
# ALMUDEN_MAX_ERRORS_PER_MINUTE=10

# ── Alerting ──────────────────────────────────────────────────────
# Discord webhook URL for alerts
# ALMUDEN_ALERT_WEBHOOK_URL=
# Telegram bot token
# ALMUDEN_TELEGRAM_BOT_TOKEN=
# Telegram chat ID
# ALMUDEN_TELEGRAM_CHAT_ID=

# ── Live trading kill switch ──────────────────────────────────────────
# Both must be explicitly set to enable live trading.
# ALMUDEN_LIVE_ENABLED=true
# ALMUDEN_LIVE_KILL_SWITCH=false

# ── Infrastructure ────────────────────────────────────────────────────
# ALMUDEN_REDIS_URL=redis://localhost:6379/0
# ALMUDEN_POSTGRES_DSN=postgresql://user:pass@localhost:5432/almuden

# ── Logging ───────────────────────────────────────────────────────────
# ALMUDEN_LOG_LEVEL=INFO
