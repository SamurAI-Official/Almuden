# AlMuden environment configuration
# Copy to .env and adjust. All values have sensible defaults in config.py.

# ── Mode ──────────────────────────────────────────────────────────────
# paper (default) | live
# ALMUDEN_MODE=paper

# ── Exchange API keys (only needed for live mode) ─────────────────────
# KUCOIN_API_KEY=
# KUCOIN_SECRET=
# KUCOIN_PASSPHRASE=
# GATEIO_API_KEY=
# GATEIO_SECRET=
# MEXC_API_KEY=
# MEXC_SECRET=
# KRAKEN_API_KEY=
# KRAKEN_SECRET=
# WHITEBIT_API_KEY=
# WHITEBIT_SECRET=

# ── Venues & symbols ──────────────────────────────────────────────────
# Comma-separated venue IDs (default: kucoin,gateio,mexc,kraken,whitebit)
# ALMUDEN_VENUES=kucoin,gateio,mexc,kraken,whitebit

# ── Arbitrage parameters ──────────────────────────────────────────────
# Minimum net edge in basis points to trigger a trade (default: 10)
# ALMUDEN_MIN_EDGE_BPS=10
# Maximum position size in quote currency per cycle (default: 100)
# ALMUDEN_MAX_POSITION=100
# Maximum inventory drift before rebalance, in bps (default: 500 = 5%)
# ALMUDEN_MAX_DRIFT_BPS=500

# ── Triangular arbitrage ─────────────────────────────────────────────
# Enable triangular arb scanning (default: true)
# ALMUDEN_TRIANGULAR_ENABLED=true
# Cross-pair symbols to poll for triangular cycles (default: XMR/ERG,ERG/XMR)
# ALMUDEN_TRIANGULAR_SYMBOLS=XMR/ERG,ERG/XMR

# ── Live trading kill switch ──────────────────────────────────────────
# Both must be explicitly set to enable live trading.
# ALMUDEN_LIVE_ENABLED=true
# ALMUDEN_LIVE_KILL_SWITCH=false

# ── Infrastructure ────────────────────────────────────────────────────
# ALMUDEN_REDIS_URL=redis://localhost:6379/0
# ALMUDEN_POSTGRES_DSN=postgresql://user:pass@localhost:5432/almuden

# ── Logging ───────────────────────────────────────────────────────────
# ALMUDEN_LOG_LEVEL=INFO
